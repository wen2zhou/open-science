# Prisma CLI only (generate/migrate/studio). At runtime the app supplies the SQLite path
# programmatically under the storage root, so this value is not used by the running app.
DATABASE_URL="file:./dev.db"

# ── Compute Jobs integration tests ──────────────────────────────────────────────────────────────
# Set RUN_COMPUTE_JOBS=1 to enable gated integration tests that run against a real SSH host.
# These are skipped in CI by default; run them locally with a configured SSH alias.
RUN_COMPUTE_JOBS=

# SSH alias of the test host (must exist in ~/.ssh/config or /etc/ssh/ssh_config).
# The tests call computeProviderId(alias) to derive the provider id — no IP is hardcoded here.
COMPUTE_TEST_SSH_ALIAS=

# ── Real SSH + Slurm release gate (Issue 07) ───────────────────────────────────────────────────
# The authoritative gate that must pass before Slurm is advertised as production-ready
# (see docs/compute-release-checklist.md). When SLURM_TEST_HOST / SLURM_TEST_PARTITION are unset the
# whole suite SKIPS with a readable reason — it does NOT fail and does NOT claim a pass.
# Run: SLURM_TEST_HOST=alias SLURM_TEST_PARTITION=cpu npx vitest run src/main/compute/slurm-e2e.test.ts
SLURM_TEST_HOST=
SLURM_TEST_PARTITION=
# Set REQUIRE_SLURM_GATE=1 (also accepts true/yes/on) to turn a MISSING gate config into a hard test
# failure instead of a silent skip. Release builds MUST set this: without it a fully green run proves
# nothing about the real cluster path. Empty / 0 / false behaves exactly like unset (skip).
# Every run prints one greppable verdict line:
#   [slurm-e2e] GATE=<ENABLED|SKIPPED|FAILED> reason=<...> host=<set|unset> partition=<set|unset> required=<0|1>
# Only "set"/"unset" is logged — never the hostname or partition value.
REQUIRE_SLURM_GATE=
# Optional: account to charge (cluster default when empty).
SLURM_TEST_ACCOUNT=
# Optional: a GPU partition for the compute-node GPU witness. When empty, the GPU case is skipped
# individually (the CPU gate still runs).
SLURM_TEST_GPU_PARTITION=
# Optional: override the remote scratch root for per-test workdirs (default ~/.openscience/e2e).
SLURM_TEST_WORKDIR_ROOT=
